      "order": 1,
      "explicitOnly": true,
      "subtitle": "Preliminary sketch",
      "date": "c. 1935",
      "facsimile": "",
      "pragmatic": {
        "support": "Graphite on a single sheet; no ruled frame, year marks scrawled at left.",
        "audience": "Barr alone. No sign the sheet was meant to be seen.",
        "permanence": "Ephemeral working paper; survives by accident of filing.",
        "constraint": "None beyond the width of the page. Space runs out at the right edge.",
        "fn": "Thinking. Barr sorts artists into loose national and personal clusters and names two 'tendencies' rather than movements."
